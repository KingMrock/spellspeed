<?xml version="1.0" encoding="utf-8"?>
<!-- Spellspeed launcher icon (brand/spellspeed): the mark on the dark tile. The foreground is mark.svg rendered at
     240 px on a 432 px canvas (108 dp at 4x), inside the 66 dp safe circle every launcher mask keeps. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
